          echo '' | base64 -d > 'android/app/src/main/java/com/ai/assistant/viewmodel/ChatViewModel.kt'
          mkdir -p "$(dirname 'android/app/src/main/res/values/strings.xml')"
          echo 'PHJlc291cmNlcz4KICAgIDxzdHJpbmcgbmFtZT0iYXBwX25hbWUiPkF1cmEgQUk8L3N0cmluZz4KPC9yZXNvdXJjZXM+Cg==' | base64 -d > 'android/app/src/main/res/values/strings.xml'
          mkdir -p "$(dirname 'android/app/src/main/res/values/themes.xml')"
          echo '' | base64 -d > 'android/app/src/main/res/values/themes.xml'
          mkdir -p "$(dirname 'android/app/src/main/res/xml/backup_rules.xml')"
          echo 'PD94bWwgdmVyc2lvbj0iMS4wIiBlbmNvZGluZz0idXRmLTgiPz4KPGZ1bGwtYmFja3VwLWNvbnRlbnQ+CiAgICA8aW5jbHVkZSBkb21haW49InNoYXJlZHByZWYiIHBhdGg9Ii4iLz4KICAgIDxpbmNsdWRlIGRvbWFpbj0iZGF0YWJhc2UiIHBhdGg9Ii4iLz4KPC9mdWxsLWJhY2t1cC1jb250ZW50Pgo=' | base64 -d > 'android/app/src/main/res/xml/backup_rules.xml'

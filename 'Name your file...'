          echo '' | base64 -d > 'android/app/src/main/java/com/ai/assistant/service/WakeWordService.kt'
          mkdir -p "$(dirname 'android/app/src/main/java/com/ai/assistant/ui/ChatScreen.kt')"
          echo '' | base64 -d > 'android/app/src/main/java/com/ai/assistant/ui/ChatScreen.kt'
          mkdir -p "$(dirname 'android/app/src/main/java/com/ai/assistant/ui/LiveVoiceScreen.kt')"

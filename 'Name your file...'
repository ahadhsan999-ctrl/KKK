          mkdir -p "$(dirname 'src/components/ChatInput.tsx')"
          echo '' | base64 -d > 'src/components/ChatInput.tsx'
          mkdir -p "$(dirname 'src/components/ChatMessage.tsx')"
          echo '' | base64 -d > 'src/components/ChatMessage.tsx'
          mkdir -p "$(dirname 'src/components/Header.tsx')"
          echo '' | base64 -d > 'src/components/Header.tsx'
          mkdir -p "$(dirname 'src/components/SettingsModal.tsx')"
          echo '' | base64 -d > 'src/components/SettingsModal.tsx'
          mkdir -p "$(dirname 'src/components/Sidebar.tsx')"
          echo '' | base64 -d > 'src/components/Sidebar.tsx'
          mkdir -p "$(dirname 'src/components/VoiceModal.tsx')"
          echo '' | base64 -d > 'src/components/VoiceModal.tsx'
          mkdir -p "$(dirname 'src/hooks/useWakeWord.ts')"
          echo '' | base64 -d > 'src/hooks/useWakeWord.ts'
          mkdir -p "$(dirname 'src/index.css')"
          echo '' | base64 -d > 'src/index.css'
          mkdir -p "$(dirname 'src/main.tsx')"
          echo 'aW1wb3J0IHtjcmVhdGVSb290fSBmcm9tICdyZWFjdC1kb20vY2xpZW50JzsKaW1wb3J0IEFwcCBmcm9tICcuL0FwcC50c3gnOwppbXBvcnQgJy4vaW5kZXguY3NzJzsKCmNyZWF0ZVJvb3QoZG9jdW1lbnQuZ2V0RWxlbWVudEJ5SWQoJ3Jvb3QnKSEpLnJlbmRlcig8QXBwIC8+KTsK' | base64 -d > 'src/main.tsx'
          mkdir -p "$(dirname 'src/services/audioEffects.ts')"
          echo '' | base64 -d > 'src/services/audioEffects.ts'
          mkdir -p "$(dirname 'src/types/index.ts')"
          echo '' | base64 -d > 'src/types/index.ts'

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: '8.5'

      - name: Build Debug APK with Gradle
        env:
          # القيم دي بتتقرأ من GitHub Repository Secrets (Settings → Secrets and variables → Actions)
          # ومتتخزنش ولا تتعرض في الكود ولا في اللوج هنا أبدًا - لو الـ secret مش موجود، بتتحقن
          # فاضية والتطبيق لسه هيشتغل، بس هيطلب من المستخدم يدخل مفتاحه بنفسه من الإعدادات.
          GEMINI_KEY_SECRET: ${{ secrets.GEMINI_KEY_SECRET }}
          GROQ_KEY_SECRET: ${{ secrets.GROQ_KEY_SECRET }}
          NVIDIA_KEY_SECRET: ${{ secrets.NVIDIA_KEY_SECRET }}
          OPENROUTER_KEY_SECRET: ${{ secrets.OPENROUTER_KEY_SECRET }}
        run: |
          cd android
          # ملاحظة: ملف gradle-wrapper.jar (اللي بيشغّل ./gradlew) مش موجود في المشروع، فبنستخدم
          # Gradle المثبت في الخطوة اللي فوق (gradle/actions/setup-gradle) مباشرة بدل الاعتماد
          # على الـ wrapper الناقص - ده بيتجنب فشل البناء بالكامل.
          gradle assembleDebug --stacktrace

      - name: Verify and Locate APK
        run: |
          find android/app/build/outputs/apk/ -name "*.apk" || find . -name "*.apk"

      - name: Upload Debug APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: AuraAI-Debug-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 30

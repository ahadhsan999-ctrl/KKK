          echo 'cGx1Z2lucyB7CiAgICBpZCgiY29tLmFuZHJvaWQuYXBwbGljYXRpb24iKSB2ZXJzaW9uICI4LjIuMiIgYXBwbHkgZmFsc2UKICAgIGlkKCJvcmcuamV0YnJhaW5zLmtvdGxpbi5hbmRyb2lkIikgdmVyc2lvbiAiMS45LjIyIiBhcHBseSBmYWxzZQogICAgaWQoImNvbS5nb29nbGUuZGV2dG9vbHMua3NwIikgdmVyc2lvbiAiMS45LjIyLTEuMC4xNyIgYXBwbHkgZmFsc2UKfQo=' | base64 -d > 'android/build.gradle.kts'
          mkdir -p "$(dirname 'android/gradle.properties')"
          echo 'b3JnLmdyYWRsZS5qdm1hcmdzPS1YbXgyMDQ4bSAtRGZpbGUuZW5jb2Rpbmc9VVRGLTgKYW5kcm9pZC51c2VBbmRyb2lkWD10cnVlCmFuZHJvaWQubm9uVHJhbnNpdGl2ZVJDbGFzcz10cnVlCmtvdGxpbi5jb2RlLnN0eWxlPW9mZmljaWFsCg==' | base64 -d > 'android/gradle.properties'
          mkdir -p "$(dirname 'android/gradle/wrapper/gradle-wrapper.properties')"
          echo '' | base64 -d > 'android/gradle/wrapper/gradle-wrapper.properties'
          mkdir -p "$(dirname 'android/gradlew')"
